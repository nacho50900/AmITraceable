# Credenciales de la app de Reddit (https://www.reddit.com/prefs/apps)
# Crear una app de tipo "web app"
REDDIT_CLIENT_ID=tu_client_id_aqui
REDDIT_CLIENT_SECRET=tu_client_secret_aqui
REDDIT_REDIRECT_URI=http://localhost:3000/auth/reddit/callback
REDDIT_USER_AGENT=tfg-identity-exposure-tool/0.1 by tu_usuario_reddit

# Clave para firmar la sesión (cookies firmadas, NO se persiste nada en BD)
SESSION_SECRET_KEY=cambia_esto_por_una_cadena_aleatoria_larga

# Credenciales de la app de Instagram (Business Login for Instagram).
# Meta for Developers -> tu app -> Instagram -> "API setup with Instagram Login"
# Requiere que el usuario tenga una cuenta Instagram Business o Creator, y
# (mientras la app esté en modo desarrollo) que esté añadido como Tester en
# App roles -> Roles. Opcional: si se deja vacío, el módulo de Reddit sigue
# funcionando igual, solo el de Instagram devuelve 503.
INSTAGRAM_APP_ID=tu_instagram_app_id_aqui
INSTAGRAM_APP_SECRET=tu_instagram_app_secret_aqui
# Opcional. Si se deja vacía, se deriva automáticamente del Host de cada
# petición (útil con túneles rápidos de Cloudflare, que cambian de URL en
# cada reinicio -- así no hay que tocar esta variable cada vez). Fíjala
# explícitamente solo si despliegas con un dominio propio y estable.
# En cualquier caso, la URL resultante debe seguir dada de alta a mano en
# Meta for Developers -> tu app -> Instagram -> API setup with Instagram
# Login -> OAuth redirect URIs (Meta no tiene API para eso).
INSTAGRAM_REDIRECT_URI=

# Frontend
# Opcional. Déjala VACÍA si usas el montaje de Docker (webapp+backend bajo
# el mismo origen, vía nginx -- ver webapp/nginx.conf): la redirección tras
# el login se deriva sola del Host de la petición, así un túnel de
# Cloudflare que cambia de URL en cada reinicio no te obliga a tocar esto.
# Fíjala explícitamente (p. ej. http://localhost:5173) solo si sirves el
# frontend en un puerto/dominio DISTINTO al del backend sin proxy delante
# (p. ej. `npm run dev` suelto, sin Docker).
FRONTEND_ORIGIN=

# Análisis con IA (opcional). Tier gratuito de Mistral AI (La Plateforme,
# https://console.mistral.ai) -- proveedor europeo (Francia), evitando
# transferencias internacionales de datos personales fuera de la UE.
# Si se deja vacío, el botón "Analizar con IA" del dashboard simplemente
# indica que no está disponible; el resto de la app sigue funcionando igual.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Análisis de CONTENIDO visual con Moondream2 (opcional, descripción de
# escena por foto). Afecta EXCLUSIVAMENTE a esto -- la geolocalización por
# similitud visual (DINOv2) no lee esta variable en ningún punto y sigue
# funcionando exactamente igual, esté esto activado o no (probado
# explícitamente en test_geolocation.py, no es solo una afirmación).
# Desactivado por defecto. Antes de activarlo, ver ADR-19 en docs/: en CPU
# sin GPU necesita ~7.6GB de RAM libres solo para el modelo.
#
# Nota aparte, no relacionada con esta variable: para que Moondream2 pueda
# funcionar en absoluto (con esto en true o en false da igual) hace falta
# construir la imagen Docker con WITH_GEOLOCATION=true, que es el mismo
# build-arg que ya usa DINOv2 para instalar torch/faiss/transformers -- ese
# build-arg decide si las librerías están instaladas, no si Moondream2 se
# usa o no; eso lo decide únicamente ENABLE_SCENE_ANALYSIS.
ENABLE_SCENE_ANALYSIS=false

# Segundos que se le da a Moondream2 para analizar UNA foto antes de
# rendirse y seguir sin descripción para esa foto (no afecta a DINOv2/
# geolocalización, que sigue su curso igual). 60 por defecto: en GPUs
# modestas (p. ej. GTX 1650, 4GB VRAM) la inferencia real puede rondar los
# ~25s, así que un valor más ajustado (el original era 30s) deja tan poco
# margen que casi cualquier foto se descarta sin descripción con la
# primera variación de carga del sistema. Sube este valor si ves en los
# logs "Análisis de contenido visual descartado para una foto: superó los
# Xs" de forma sistemática (no puntual) -- eso indica que tu hardware
# necesita más margen, no que algo esté roto.
SCENE_ANALYSIS_TIMEOUT_SECONDS=60

# Nº de fotos que se analizan EN PARALELO con los modelos de visión
# (DINOv2 + Moondream2). Indirectamente, esto también decide cuántos
# hilos de PyTorch usa CADA inferencia (núcleos disponibles / este
# número, ver app/main.py) -- fuerza así el reparto de los núcleos de la
# máquina entre "más fotos a la vez" y "cada foto más rápida", una
# decisión que en la práctica depende de cuántos núcleos tenga el
# servidor donde se despliegue.
#
# RECOMENDADO: dejarla VACÍA. Si se deja vacía, se calcula sola a partir
# de los núcleos de la máquina en cada arranque (ver
# `_default_photo_analysis_concurrency` en app/config.py) -- no hay que
# tocar esto al cambiar de servidor. Fijar un número aquí lo deja
# CONSTANTE pase lo que pase en la máquina donde corra; solo tiene
# sentido si se quiere forzar un valor concreto para comparar
# configuraciones a propósito (ver scripts/analyze_performance_log.py).
PHOTO_ANALYSIS_CONCURRENCY=

# Logs de rendimiento (backend/data/performance/*.jsonl -- tiempo total y
# por etapa de cada análisis, tiempo por foto). Son datos puramente
# técnicos (núm. de posts/fotos, segundos), SIN nada personal: ni
# username, ni bio, ni permalinks. Activado por defecto -- pensado para
# tener datos reales con los que justificar decisiones de rendimiento en
# la memoria del TFG (ver scripts/analyze_performance_log.py y
# scripts/analyze_analysis_run_log.py). Poner a false solo si se prefiere
# no acumular estos ficheros en absoluto.
ENABLE_PERFORMANCE_LOGGING=true
